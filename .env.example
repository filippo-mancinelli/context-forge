# ─────────────────────────────────────────────────
# context-forge — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# PostgreSQL password (choose a strong password)
POSTGRES_PASSWORD=changeme_strong_password

# First-run setup token (used by onboarding wizard once)
SETUP_BOOTSTRAP_TOKEN=change_this_bootstrap_token

# When the web UI is served from a different origin than the API, list allowed UI origins here.
# Comma-separated. Supports three forms:
#   exact origin:        CORS_ORIGINS=https://app.example.com
#   subdomain wildcard:  CORS_ORIGINS=*.example.com
#   allow all origins:   CORS_ORIGINS=*   (disables credentials, fine for most self-hosted setups)
#
# Examples:
# CORS_ORIGINS=https://app.example.com
# CORS_ORIGINS=https://app.example.com,https://staging.example.com
# CORS_ORIGINS=*.traefik.me
# CORS_ORIGINS=*

# ─── Embeddings ───────────────────────────────────
# Provider: openai | jina | openai-compatible | local
#
# openai (default):
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMS=1536
# Requires OPENAI_API_KEY. Cost: ~$0.02 / 1M tokens (basically free).
#
# Jina AI (1M tokens/month FREE — get key at https://jina.ai):
# EMBEDDINGS_PROVIDER=jina
# EMBEDDINGS_MODEL=jina-embeddings-v3
# EMBEDDINGS_DIMS=1024
# EMBEDDINGS_API_KEY=jina_...
#
# Any OpenAI-compatible endpoint (Together AI, Voyage, etc.):
# EMBEDDINGS_PROVIDER=openai-compatible
# EMBEDDINGS_BASE_URL=https://api.together.xyz/v1
# EMBEDDINGS_MODEL=togethercomputer/m2-bert-80M-8k-retrieval
# EMBEDDINGS_DIMS=768
# EMBEDDINGS_API_KEY=your_key_here
#
# Local (no API key, runs on your machine — requires EMBEDDINGS_PROVIDER=local at build time):
# EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL=all-MiniLM-L6-v2
# EMBEDDINGS_DIMS=384

# ─── LLM (for Mem0 memory extraction) ─────────────
# Provider: openai | anthropic | deepseek
# deepseek is fast and cheap — recommended if you have a key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# DeepSeek example:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat

# ─── API Keys ─────────────────────────────────────
OPENAI_API_KEY=sk-...

# Anthropic (optional, if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek (optional, if LLM_PROVIDER=deepseek — fast and very cheap)
# DEEPSEEK_API_KEY=sk-...

# ─── Git Remote Repos ─────────────────────────────
# GitHub personal access token (repo scope)
GITHUB_TOKEN=

# GitLab token (read_repository scope)
# For a single GitLab instance:
GITLAB_TOKEN=

# GitLab API base. Empty means gitlab.com; for a self-hosted instance set the
# root (https://gitlab.example.com) or the full API URL (https://gitlab.example.com/api/v4)
GITLAB_URL=

# For multiple GitLab instances, use per-repo tokens in context-forge.yml

# ─── Webhooks ─────────────────────────────────────
# Shared secret for POST /api/webhooks/index, which triggers incremental
# re-indexing when a repo is pushed. Leave empty to disable the endpoint.
#   GitHub:  set this as the webhook Secret (HMAC-SHA256, X-Hub-Signature-256)
#   GitLab:  set this as the webhook Secret token (X-Gitlab-Token)
#   generic: send it as the X-Webhook-Secret header
WEBHOOK_SECRET=

# ─── MCP endpoint auth ────────────────────────────
# disabled   → no authentication on :4000/mcp (local development only)
# transition → API keys and OIDC tokens are honored when present;
#              anonymous callers only get read-only tools
# enabled    → every MCP request must carry an API key (X-API-Key or
#              Authorization: Bearer) or an OIDC bearer token
MCP_AUTH_MODE=disabled

# Days of MCP tool-call audit history kept in mcp_tool_calls. A daily job
# deletes older rows; 0 disables the purge and keeps everything.
MCP_AUDIT_RETENTION_DAYS=90

# ─── Secrets at rest ──────────────────────────────
# Symmetric key used to encrypt stored data-source and SSH credentials
# (any random string; it is hashed to derive the Fernet key).
# Empty means credentials are stored obfuscated but NOT encrypted.
ENCRYPTION_KEY=

# ─── OIDC login (optional; inert unless enabled) ──
# Any OIDC provider with a JWKS endpoint works (Keycloak, Authentik, Entra ID, ...).
# When enabled the UI login redirects to the provider, users are provisioned on
# first login, the MCP endpoint accepts the provider's bearer tokens and acts as
# an OAuth bridge so MCP clients can log in from the browser without an API key.
OIDC_ENABLED=false
OIDC_ISSUER=https://sso.example.com/realms/myrealm
OIDC_CLIENT_ID=context-forge
OIDC_CLIENT_SECRET=
# Expected `aud` claim in access tokens (empty = not checked beyond the issuer)
OIDC_AUDIENCE=
# JWKS endpoint (empty = discovered from the issuer)
OIDC_JWKS_URL=
# Provider groups under this prefix suggest the initial organization role
# on first login (e.g. /mcp-tools/admin); authorization itself lives in the DB
OIDC_GROUP_PREFIX=/mcp-tools/
# Token claim carrying the organization slug
OIDC_ORG_CLAIM=tenant_id
# Public URL of the API, used for OIDC redirects (e.g. https://forge.example.com)
PUBLIC_BASE_URL=
# Public URL of the UI, used for the post-login redirect
UI_BASE_URL=
# Public base of the MCP endpoint (e.g. https://forge.example.com:4000), used in
# the OAuth discovery metadata and the WWW-Authenticate header.
# Empty = derived from the incoming request.
PUBLIC_MCP_URL=

# ─── UI ───────────────────────────────────────────
# URL of the API, as seen from the browser
VITE_API_URL=http://localhost:8000

# ─── Search ───────────────────────────────────────
# Hybrid retrieval fuses dense vector similarity with lexical full-text ranking
# (Reciprocal Rank Fusion) so exact identifiers/error strings surface alongside
# semantic matches. Set to false for vector-only search.
SEARCH_HYBRID=true

# Work memory used while building the per-organization HNSW vector indexes.
# Bigger is faster (the build is single-connection and runs in the background);
# it is applied only on the dedicated maintenance connection.
HNSW_MAINTENANCE_WORK_MEM=256MB

# ─── Storage ──────────────────────────────────────
# Where uploaded knowledge-base documents are stored on disk (inside the container).
KB_DATA_DIR=/data/kb
# Scratch git workspaces for repo_commit_files / repo_open_pr (separate from the index cache).
AGENT_WORKSPACES_DIR=/data/agent-workspaces

# ─── Metrics ──────────────────────────────────────
# Bearer token required by GET /metrics (Prometheus text exposition).
# Leave empty to expose the endpoint without authentication — only do that
# when the port is reachable from a private scraping network.
METRICS_TOKEN=

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=INFO
